extends ../layouts/base

block variables
  - pageTitle = 'About Us'
  - pageDescription = 'Learn more about our travel planning and services.'
  - pageKeywords = 'about travel, tourism, services'

block body-content
  // $Page header
  header.page-header
    .page-header__inner
      h1.page-header__logo
        | Indo
        span Tourism

      // $Page navigation
      nav.page-nav
        a.page-nav__link(href='index.html') Home
        a.page-nav__link.is-highlighted(href='about.html') About us
        a.page-nav__link(href='projects.html') Projects
        a.page-nav__link(href='https://testimonials.stressfreecruise.com/') Testimonials
        a.page-nav__link.page-nav__link_special(href='contact.html') Contact us

  // $Page content
  .page-content
    main.page-content__main
      // $Promo
      section.promo
        .promo__inner
          h1.promo__title
            | Discover Who We Are
            span Your trusted travel partner
          a.promo__button(href='#') Learn more

      // $Info
      section.info
        .info__places
          // $Places
          .places
            h2.places__title Places You Must Visit In Your Lifetime
            a(href='#').places__link
              span.places__loc.places__loc_1
              | Azheekal
            a(href='#').places__link
              span.places__loc.places__loc_2
              | Ooty
            a(href='#').places__link
              span.places__loc.places__loc_3
              | Munnar
            a(href='#').places__link
              span.places__loc.places__loc_4
              | Humpi
            a(href='#').places__link
              span.places__loc.places__loc_5
              | Kovalam
            a(href='#').places__link
              span.places__loc.places__loc_6
              | Kuttanad
            a(href='#').places__link
              span.places__loc.places__loc_7
              | Thenmala
            a(href='#').places__link
              span.places__loc.places__loc_8
              | Beach
            a(href='#').places__link
              span.places__loc.places__loc_9
              | Munnar
            a(href='#').places__link
              span.places__loc.places__loc_10
              | Punaloor

        .info__inner
          h3.info__content
            | We combine local travel knowledge with modern planning
            br
            | to give you the best journey possible.

          .info__services
            // $Services
            .services
              a(href='#').services__link
                span.services__logo.services__logo_sites
                | Sites the world
              a(href='#').services__link
                span.services__logo.services__logo_shopping
                | Shopping
              a(href='#').services__link
                span.services__logo.services__logo_photography
                | Photography
              a(href='#').services__link
                span.services__logo.services__logo_find-best
                | Find the best

  // $Page footer
  footer.page-footer
    .page-footer__inner
      p.page-footer__text Designed by cssauthor.com | Coded by orlovmax.com
